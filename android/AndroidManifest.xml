<?xml version="1.0" encoding="utf-8"?>
<!-- One activity, no Java beyond the pad shim: native-activity owns the window
     and hands it to winit, which hands it to eframe/egui. Landscape, gamepad
     optional, touch welcome. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.crownpark.fz10"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- The library, the discs and the artwork live in /sdcard/fz10, which a
         person fills from a file manager or adb. Without the grant the app
         falls back to its own external files dir (see the gui's config_dir). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="Retro 3DO"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name="com.crownpark.fz10.Fz10Activity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|navigation">

            <meta-data
                android:name="android.app.lib_name"
                android:value="retro3do_gui" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
